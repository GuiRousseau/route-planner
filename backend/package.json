{
  "name": "route-planner-backend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "import:osm": "bun run src/scripts/import-osm-data.ts",
    "build": "bun run src/scripts/ensure-osm-data.ts && bun build src/server.ts --target=bun --outdir dist",
    "start": "bun dist/server.js",
    "test": "bun test",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
