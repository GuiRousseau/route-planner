{
  "name": "route-planner",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "bun --cwd frontend run dev",
    "dev:backend": "bun --cwd backend run dev",
    "dev": "bun --cwd frontend run dev & bun --cwd backend run dev",
    "build": "bun --cwd frontend run build && bun --cwd backend run build",
    "start:frontend": "bun --cwd frontend run preview",
    "start:backend": "bun --cwd backend run start"
  }
}
